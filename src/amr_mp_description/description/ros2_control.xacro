<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="robot_ros2_control">

    <ros2_control name="PoleBotHardware" type="system">

      <hardware>

        <plugin>amr_mp_hardware/PoleBotHardwareInterface</plugin>

        <!-- Parameter hardware — harus sinkron dengan plc_driver_params.yaml -->

        <param name="ticks_per_rev">360000.0</param>

        <param name="gear_ratio">1.0</param>

        <param name="wheel_radius_m">0.055</param>

        <param name="max_linear_vel">0.5</param>

        <param name="wheel_ticks_topic">/wheel_ticks</param>

        <param name="wheel_cmd_topic">/wheel_cmd_vel</param>

      </hardware>

      <!-- left_wheel_joint: velocity command + position/velocity state -->

      <joint name="left_wheel_joint">

        <command_interface name="velocity">

          <param name="min">-10</param>

          <param name="max">10</param>

        </command_interface>

        <state_interface name="position"/>

        <state_interface name="velocity"/>

      </joint>

      <!-- right_wheel_joint: velocity command + position/velocity state -->

      <joint name="right_wheel_joint">

        <command_interface name="velocity">

          <param name="min">-10</param>

          <param name="max">10</param>

        </command_interface>

        <state_interface name="position"/>

        <state_interface name="velocity"/>

      </joint>

    </ros2_control>

  </xacro:macro>

</robot>

