
<?xml version="1.0"?>

<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>amr_hardware_bridge</name>

  <version>1.0.0</version>

  <description>

    Hardware Abstraction Layer untuk AMR Polebot.

    Node tunggal yang memegang koneksi MC Protocol ke PLC Mitsubishi.

    Menangani enkoder read, motor write, zero-crossing interlock,

    encoder jump filter, dan heartbeat.

  </description>

  <maintainer email="miraenk7@gmail.com">Hafizh Husaini</maintainer>

  <license>Apache-2.0</license>



  <depend>rclpy</depend>

  <depend>std_msgs</depend>



  <test_depend>ament_copyright</test_depend>

  <test_depend>ament_flake8</test_depend>

  <test_depend>ament_pep257</test_depend>

  <test_depend>python3-pytest</test_depend>



  <export>

    <build_type>ament_python</build_type>

  </export>

</package>

