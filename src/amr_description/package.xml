
<?xml version="1.0"?>

<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>amr_description</name>

  <version>1.0.0</version>

  <description>

    Robot description package untuk AMR Polebot.

    Berisi URDF/xacro, launch files, dan RViz config.

    Nilai dimensi sudah dikoreksi sesuai digital_twin_enhanced.py.

  </description>

  <maintainer email="miraenk7@gmail.com">Hafizh Husaini</maintainer>

  <license>Apache-2.0</license>



  <buildtool_depend>ament_cmake</buildtool_depend>



  <depend>rclpy</depend>

  <depend>robot_state_publisher</depend>

  <depend>joint_state_publisher</depend>

  <depend>xacro</depend>

  <depend>tf2_ros</depend>

  <depend>rviz2</depend>



  <test_depend>ament_lint_auto</test_depend>

  <test_depend>ament_lint_common</test_depend>



  <export>

    <build_type>ament_cmake</build_type>

  </export>

</package>

